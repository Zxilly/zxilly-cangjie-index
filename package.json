  "engines": {
    "node": ">=24.14.1",
    "pnpm": ">=11.18.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
