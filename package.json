  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc -b && react-router build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src vite.config.ts vitest.config.ts react-router.config.ts",
